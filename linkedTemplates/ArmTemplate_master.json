{
    "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "factoryName": {
            "type": "string",
            "metadata": "Data Factory name",
            "defaultValue": "adf-azuredatalib-dev"
        },
        "LS_SQL_SERVER_password": {
            "type": "secureString",
            "metadata": "Secure string for 'password' of 'LS_SQL_SERVER'"
        },
        "TRG_Storage_CSV_Arrival_properties_PL_Storage_Event_Demo_parameters_FileName": {
            "type": "string",
            "defaultValue": "@triggerBody().fileName"
        },
        "TRG_Storage_CSV_Arrival_properties_PL_Storage_Event_Demo_parameters_FolderPath": {
            "type": "string",
            "defaultValue": "@triggerBody().folderPath"
        },
        "TRG_Storage_CSV_Arrival_properties_typeProperties_scope": {
            "type": "string",
            "defaultValue": "/subscriptions/89c38206-bb1d-483a-b4cd-f9cd5ab3976a/resourceGroups/rg-azuredatalib-dev/providers/Microsoft.Storage/storageAccounts/azurelibacademy1234"
        },
        "trigger_properties_pipeline_parameters_WindowStart": {
            "type": "string",
            "defaultValue": "@trigger().outputs.windowStartTime"
        },
        "trigger_properties_pipeline_parameters_WindowEnd": {
            "type": "string",
            "defaultValue": "@trigger().outputs.windowEndTime"
        },
        "TRG_Custom_Sales_Approved_properties_PL_Custom_event_Demo_parameters_dataApprovalID": {
            "type": "string",
            "defaultValue": "@triggerBody().event.data.ApprovalID"
        },
        "TRG_Custom_Sales_Approved_properties_typeProperties_scope": {
            "type": "string",
            "defaultValue": "/subscriptions/89c38206-bb1d-483a-b4cd-f9cd5ab3976a/resourceGroups/rg-azuredatalib-dev/providers/Microsoft.EventGrid/topics/eg-adf-training-events"
        },
        "LS_ADLS_TRANING_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://azurelibacademy1234.dfs.core.windows.net/"
        },
        "LS_SQL_SERVER_properties_typeProperties_server": {
            "type": "string",
            "defaultValue": "sqlserver-training-1.database.windows.net"
        },
        "LS_SQL_SERVER_properties_typeProperties_database": {
            "type": "string",
            "defaultValue": "free-sql-db-4869014"
        },
        "LS_SQL_SERVER_properties_typeProperties_userName": {
            "type": "string",
            "defaultValue": "adf-azuredatalib-dev"
        },
        "LS_REST_Training_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://jsonplaceholder.typicode.com/"
        },
        "containerUri": {
            "type": "string",
            "metadata": "URI to storage account containing linked ARM templates"
        },
        "containerSasToken": {
            "type": "string",
            "metadata": "Sas token to storage account containing linked ARM templates"
        }
    },
    "variables": {
        "factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
    },
    "resources": [
        {
            "name": "adf-azuredatalib-dev_ArmTemplate_0",
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2024-03-01",
            "properties": {
                "mode": "incremental",
                "templateLink": {
                    "uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "factoryName": {
                        "value": "[parameters('factoryName')]"
                    },
                    "LS_SQL_SERVER_password": {
                        "value": "[parameters('LS_SQL_SERVER_password')]"
                    },
                    "LS_ADLS_TRANING_properties_typeProperties_url": {
                        "value": "[parameters('LS_ADLS_TRANING_properties_typeProperties_url')]"
                    },
                    "LS_SQL_SERVER_properties_typeProperties_server": {
                        "value": "[parameters('LS_SQL_SERVER_properties_typeProperties_server')]"
                    },
                    "LS_SQL_SERVER_properties_typeProperties_database": {
                        "value": "[parameters('LS_SQL_SERVER_properties_typeProperties_database')]"
                    },
                    "LS_SQL_SERVER_properties_typeProperties_userName": {
                        "value": "[parameters('LS_SQL_SERVER_properties_typeProperties_userName')]"
                    },
                    "LS_REST_Training_properties_typeProperties_url": {
                        "value": "[parameters('LS_REST_Training_properties_typeProperties_url')]"
                    },
                    "TRG_Storage_CSV_Arrival_properties_PL_Storage_Event_Demo_parameters_FileName": {
                        "value": "[parameters('TRG_Storage_CSV_Arrival_properties_PL_Storage_Event_Demo_parameters_FileName')]"
                    },
                    "TRG_Storage_CSV_Arrival_properties_PL_Storage_Event_Demo_parameters_FolderPath": {
                        "value": "[parameters('TRG_Storage_CSV_Arrival_properties_PL_Storage_Event_Demo_parameters_FolderPath')]"
                    },
                    "TRG_Storage_CSV_Arrival_properties_typeProperties_scope": {
                        "value": "[parameters('TRG_Storage_CSV_Arrival_properties_typeProperties_scope')]"
                    },
                    "trigger_properties_pipeline_parameters_WindowStart": {
                        "value": "[parameters('trigger_properties_pipeline_parameters_WindowStart')]"
                    },
                    "trigger_properties_pipeline_parameters_WindowEnd": {
                        "value": "[parameters('trigger_properties_pipeline_parameters_WindowEnd')]"
                    },
                    "TRG_Custom_Sales_Approved_properties_PL_Custom_event_Demo_parameters_dataApprovalID": {
                        "value": "[parameters('TRG_Custom_Sales_Approved_properties_PL_Custom_event_Demo_parameters_dataApprovalID')]"
                    },
                    "TRG_Custom_Sales_Approved_properties_typeProperties_scope": {
                        "value": "[parameters('TRG_Custom_Sales_Approved_properties_typeProperties_scope')]"
                    }
                }
            },
            "dependsOn": []
        },
        {
            "name": "adf-azuredatalib-dev_ArmTemplate_1",
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2024-03-01",
            "properties": {
                "mode": "incremental",
                "templateLink": {
                    "uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "factoryName": {
                        "value": "[parameters('factoryName')]"
                    }
                }
            },
            "dependsOn": [
                "[resourceId('Microsoft.Resources/deployments', 'adf-azuredatalib-dev_ArmTemplate_0')]"
            ]
        },
        {
            "name": "adf-azuredatalib-dev_ArmTemplate_2",
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2024-03-01",
            "properties": {
                "mode": "incremental",
                "templateLink": {
                    "uri": "[concat(parameters('containerUri'), '/ArmTemplate_2.json', parameters('containerSasToken'))]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "factoryName": {
                        "value": "[parameters('factoryName')]"
                    }
                }
            },
            "dependsOn": [
                "[resourceId('Microsoft.Resources/deployments', 'adf-azuredatalib-dev_ArmTemplate_1')]"
            ]
        }
    ]
}